# Deterministic numeric checks of the native Flow training primitives.
# Run from repository root: flow run tests/smoke.flow

import "src/core.flow"
import "src/data.flow"
import "src/whitening.flow"
import "src/checkpoint.flow"

function absf(x: f32) -> f32 {
    if x < 0.0 { return 0.0-x }
    return x
}

function conv_gradient_check() -> bool {
    let conv: Conv = conv_new(1,1,3,1,false)
    let x: Tensor = tensor(1,1,3,3)
    for i in 0 to 9 { x.data[i] = 0.1 + (i as f32)*0.17 }
    let y: Tensor = conv_forward(conv,x)
    let dy: Tensor = tensor(1,1,3,3)
    for i in 0 to 9 { dy.data[i] = 1.0 }
    let dx: Tensor = conv_backward(conv,x,dy)

    let analytic: f32 = conv.grad[4]
    let start: f32 = conv.weight[4]
    conv.weight[4] = start+0.001
    let pos: Tensor = conv_forward(conv,x)
    let mut lp: f32 = 0.0
    for i in 0 to 9 { lp = lp+pos.data[i] }

    conv.weight[4] = start-0.001
    let neg: Tensor = conv_forward(conv,x)
    let mut lm: f32 = 0.0
    for i in 0 to 9 { lm = lm+neg.data[i] }

    let finite: f32 = (lp-lm)/0.002
    let ok: bool = absf(analytic-finite) < 0.005 and absf(dx.data[4]) > 0.00001
    tensor_free(pos)
    tensor_free(neg)
    tensor_free(dx)
    tensor_free(dy)
    tensor_free(y)
    tensor_free(x)
    conv_free(conv)
    return ok
}

function gelu_gradient_check() -> bool {
    let x: f32 = 0.47
    let slope: f32 = (gelu(x+0.0001)-gelu(x-0.0001))/0.0002
    return absf(slope-gelu_prime(x)) < 0.003
}

function batchnorm_gradient_check() -> bool {
    let norm: Norm = norm_new(1)
    let x: Tensor = tensor(2,1,2,2)
    let dy: Tensor = tensor(2,1,2,2)
    for i in 0 to 8 {
        x.data[i] = (i as f32)*0.21-0.4
        dy.data[i] = (i as f32)*0.17+0.15
    }
    let original: Tensor = norm_forward(norm,x,true)
    let dx: Tensor = norm_backward(norm,x,dy)
    let analytical: f32 = dx.data[2]

    let saved: f32 = x.data[2]
    x.data[2] = saved+0.001
    let plus: Tensor = norm_forward(norm,x,true)
    let mut sp: f32 = 0.0
    for i in 0 to 8 { sp = sp + plus.data[i]*dy.data[i] }

    x.data[2] = saved-0.001
    let minus: Tensor = norm_forward(norm,x,true)
    let mut sm: f32 = 0.0
    for i in 0 to 8 { sm = sm + minus.data[i]*dy.data[i] }

    let numeric: f32 = (sp-sm)/0.002
    let ok: bool = absf(analytical-numeric) < 0.01
    tensor_free(original)
    tensor_free(plus)
    tensor_free(minus)
    tensor_free(dx)
    tensor_free(x)
    tensor_free(dy)
    norm_free(norm)
    return ok
}

function pooling_gradient_check() -> bool {
    let x: Tensor = tensor(1,1,4,4)
    for i in 0 to 16 { x.data[i] = i as f32 }
    let indices: ptr<i32> = alloc_i32(4)
    let out: Tensor = pool2_forward(x,indices)
    let dy: Tensor = tensor(1,1,2,2)
    for i in 0 to 4 { dy.data[i] = 1.0 }
    let dx: Tensor = pool2_backward(x,dy,indices)
    let ok: bool = out.data[0] == 5.0 and out.data[3] == 15.0 and
        dx.data[5] == 1.0 and dx.data[0] == 0.0 and dx.data[15] == 1.0
    tensor_free(dx)
    tensor_free(dy)
    tensor_free(out)
    tensor_free(x)
    free(indices as ptr<f32>)
    return ok
}

function whitening_check() -> bool {
    let d: Dataset = dataset_create(4)
    for i in 0 to 4*3072 {
        d.images[i] = ((i*19 % 211) as f32) / 211.0
    }
    let conv: Conv = conv_new(3,24,2,0,false)
    whitening_fit_stride(conv,d,4,1)
    let mut ok: bool = true
    for i in 0 to 144 {
        if absf(conv.weight[i]+conv.weight[i+144]) > 0.00001 { ok = false }
        if not (conv.weight[i] < 100000.0 and conv.weight[i] > -100000.0) { ok = false }
    }
    # Exhaustive-patch covariance must preserve the signed filter pairs.
    conv_free(conv)
    dataset_free(d)
    return ok
}

function train_step_check() -> bool {
    let m: Model = model_new(2)
    let images: Tensor = tensor(2,3,32,32)
    for i in 0 to 2*3072 {
        images.data[i] = ((i*7 % 101) as f32)/100.0
    }
    let targets: ptr<f32> = alloc_f32(20)
    targets[0] = 1.0
    targets[CLASSES+1] = 1.0
    let c: ModelCache = model_forward(m,images,true)
    let loss: f32 = model_backward(m,c,targets)
    let before: f32 = m.head.weight[0]
    model_step(m,0.01,2)
    let after: f32 = m.head.weight[0]
    let ok: bool = loss > 0.0 and loss < 1000.0 and
        absf(before-after) > 0.00000001
    model_cache_free(c)
    free(targets)
    tensor_free(images)
    model_free(m)
    return ok
}

# Optimized kernel must match the independently implemented reference
# in both the forward and backward directions on nontrivial channel shapes.
function conv_reference_check() -> bool {
    let c: Conv = conv_new(2,3,3,1,false)
    let ref: Conv = conv_new(2,3,3,1,false)
    for i in 0 to conv_count(c) {
        ref.weight[i] = c.weight[i]
    }
    let x: Tensor = tensor(2,2,5,7)
    for i in 0 to 2*2*5*7 {
        x.data[i] = ((i*13%101) as f32)*0.009-0.35
    }
    let y: Tensor = conv_forward(c,x)
    let yr: Tensor = conv_forward_reference(ref,x)
    let g: Tensor = tensor(y.n,y.c,y.h,y.w)
    let mut max_error: f32 = 0.0
    for i in 0 to y.n*y.c*y.h*y.w {
        let diff: f32 = absf(y.data[i]-yr.data[i])
        if diff > max_error { max_error = diff }
        g.data[i] = ((i*17%91) as f32)*0.01-0.3
    }
    let dx: Tensor = conv_backward(c,x,g)
    let dxr: Tensor = conv_backward_reference(ref,x,g)
    for i in 0 to x.n*x.c*x.h*x.w {
        let diff: f32 = absf(dx.data[i]-dxr.data[i])
        if diff > max_error { max_error = diff }
    }
    for i in 0 to conv_count(c) {
        let diff: f32 = absf(c.grad[i]-ref.grad[i])
        if diff > max_error { max_error = diff }
    }
    tensor_free(x)
    tensor_free(y)
    tensor_free(yr)
    tensor_free(g)
    tensor_free(dx)
    tensor_free(dxr)
    conv_free(c)
    conv_free(ref)
    return max_error < 0.0005
}

function conv_valid_padding_check() -> bool {
    let c: Conv = conv_new(3,4,2,0,false)
    let x: Tensor = tensor(1,3,4,6)
    for i in 0 to 3*4*6 { x.data[i] = ((i*31%77) as f32)*0.01 }
    let y: Tensor = conv_forward(c,x)
    let yr: Tensor = conv_forward_reference(c,x)
    let mut ok: bool = y.h == 3 and y.w == 5
    for i in 0 to y.n*y.c*y.h*y.w {
        if absf(y.data[i]-yr.data[i]) > 0.0001 { ok = false }
    }
    tensor_free(x)
    tensor_free(y)
    tensor_free(yr)
    conv_free(c)
    return ok
}

function learning_rate_ratio_check() -> bool {
    let m: Model = model_new(2)
    m.first.a.weight[0] = 0.0
    m.first.a.grad[0] = 1.0
    m.first.norm_a.bias[0] = 0.0
    m.first.norm_a.grad[0] = 1.0
    model_step(m,0.01,2)
    let delta_w: f32 = absf(m.first.a.weight[0])
    let delta_b: f32 = absf(m.first.norm_a.bias[0])
    let ok: bool = absf(delta_w-0.0185) < 0.00001 and
        absf(delta_b-1.184) < 0.0005 and
        absf(delta_b/delta_w-64.0) < 0.01
    model_free(m)
    return ok
}

function augmentation_check() -> bool {
    let data: Dataset = dataset_create(3)
    for i in 0 to 3*3072 { data.images[i] = ((i*7%113) as f32)*0.01 }
    for i in 0 to 3 { data.labels[i] = i }
    let indices: ptr<i32> = shuffled_indices(3)
    let mut ok: bool = true
    for repeat in 0 to 40 {
        let batch: Batch = batch_from_dataset(data,indices,0,3,true,true)
        for b in 0 to 3 {
            let mut sum: f32 = 0.0
            for k in 0 to CLASSES { sum = sum+batch.targets[b*CLASSES+k] }
            if absf(sum-1.0) > 0.00001 { ok = false }
        }
        batch_free(batch)
    }
    free(indices as ptr<f32>)
    dataset_free(data)
    return ok
}

function running_variance_check() -> bool {
    let norm: Norm = norm_new(1)
    let x: Tensor = tensor(2,1,1,1)
    x.data[0] = 0.0
    x.data[1] = 2.0
    let y: Tensor = norm_forward(norm,x,true)
    let eval_output: Tensor = norm_forward(norm,x,false)
    let ok: bool = absf(norm.running_mean[0]-0.4) < 0.000001 and
        absf(norm.running_var[0]-1.4) < 0.000001 and
        absf(y.data[0]+1.0) < 0.0001 and
        absf(eval_output.data[0]+0.4/sqrtf(1.4)) < 0.0001
    tensor_free(x)
    tensor_free(y)
    tensor_free(eval_output)
    norm_free(norm)
    return ok
}

function checkpoint_roundtrip_check() -> bool {
    let m: Model = model_new(2)
    m.whitening.weight[17] = 0.123456
    m.first.a.weight[0] = 1.25
    m.second.norm_a.bias[0] = -0.25
    m.third.norm_b.running_mean[0] = 0.75
    m.third.norm_b.running_var[0] = 1.5
    m.head.weight[12] = -0.333
    let saved: bool = checkpoint_save("smoke-model.bin",m,2)
    let loaded: Model = model_new(2)
    let read_ok: bool = checkpoint_load("smoke-model.bin",loaded,2)
    let same: bool = loaded.whitening.weight[17] == m.whitening.weight[17] and
        loaded.first.a.weight[0] == m.first.a.weight[0] and
        loaded.second.norm_a.bias[0] == m.second.norm_a.bias[0] and
        loaded.third.norm_b.running_mean[0] == m.third.norm_b.running_mean[0] and
        loaded.third.norm_b.running_var[0] == m.third.norm_b.running_var[0] and
        loaded.head.weight[12] == m.head.weight[12]
    let wrong_width: Model = model_new(3)
    let rejected: bool = not checkpoint_load("smoke-model.bin",wrong_width,3)
    let _cleanup: i32 = remove("smoke-model.bin")
    model_free(wrong_width)
    model_free(loaded)
    model_free(m)
    return saved and read_ok and same and rejected
}

function main() -> i32 {
    let a: bool = conv_gradient_check()
    let b: bool = gelu_gradient_check()
    let c: bool = batchnorm_gradient_check()
    let d: bool = pooling_gradient_check()
    let e: bool = whitening_check()
    let f: bool = train_step_check()
    let g: bool = conv_reference_check()
    let h: bool = conv_valid_padding_check()
    let i: bool = learning_rate_ratio_check()
    let j: bool = augmentation_check()
    let k: bool = running_variance_check()
    let l: bool = checkpoint_roundtrip_check()
    print("conv_gradient "); println(a)
    print("gelu_gradient "); println(b)
    print("batchnorm_gradient "); println(c)
    print("pool_gradient "); println(d)
    print("whitening "); println(e)
    print("network_train_step "); println(f)
    print("optimized_conv_matches_reference "); println(g)
    print("valid_conv_matches_reference "); println(h)
    print("bias_lr_64x "); println(i)
    print("cutmix_normalized_labels "); println(j)
    print("pytorch_running_bn_variance "); println(k)
    print("checkpoint_roundtrip "); println(l)
    if a and b and c and d and e and f and g and h and i and j and k and l {
        println("PASS")
        return 0
    }
    println("FAIL")
    return 1
}
