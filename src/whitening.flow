# Native Flow PCA whitening, covariance streamed over the training images.
# Stride 1 visits all 31x31 overlapping 2x2 patches per image; larger strides
# give a reproducible, cheaper approximation for development CPU runs.
# Eigenvectors use symmetric Jacobi rotations; signed pairs are frozen filters.
# Unlike HLB's per-5000-image eigendecomposition averaging, covariance is
# combined BEFORE one global decomposition, avoiding eigenvector sign mismatch.

function whitening_fit_stride(layer: Conv, d: Dataset, examples: i32, requested_stride: i32) -> void {
    let mut n: i32 = examples
    if n > d.count { n = d.count }
    if n <= 0 { return }
    let mut stride: i32 = requested_stride
    if stride < 1 { stride = 1 }
    if stride > 31 { stride = 31 }

    # Compute first and second raw moments in f64, independent of number
    # of patches, without materializing the hundreds of millions of patches.
    let sums: ptr<f64> = malloc((12 as i64)*8) as ptr<f64>
    let seconds: ptr<f64> = malloc((144 as i64)*8) as ptr<f64>
    for i in 0 to 12 { sums[i] = 0.0 }
    for i in 0 to 144 { seconds[i] = 0.0 }
    let patch: ptr<f32> = alloc_f32(12)
    let mut count: i32 = 0

    for sample in 0 to n {
        let mut y: i32 = 0
        while y < 31 {
            let mut x: i32 = 0
            while x < 31 {
                for ch in 0 to 3 {
                    for ky in 0 to 2 {
                        for kx in 0 to 2 {
                            let i: i32 = ch*4+ky*2+kx
                            patch[i] = d.images[sample*3072+ch*1024+(y+ky)*32+(x+kx)]
                        }
                    }
                }
                for i in 0 to 12 {
                    let vi: f64 = patch[i] as f64
                    sums[i] = sums[i] + vi
                    for j in 0 to 12 {
                        seconds[i*12+j] = seconds[i*12+j] + vi*(patch[j] as f64)
                    }
                }
                count = count+1
                x = x+stride
            }
            y = y+stride
        }
    }

    let covariance: ptr<f32> = alloc_f32(144)
    if count > 1 {
        let n64: f64 = count as f64
        for i in 0 to 12 {
            for j in 0 to 12 {
                let centered: f64 = seconds[i*12+j]-sums[i]*sums[j]/n64
                covariance[i*12+j] = (centered/(n64-1.0)) as f32
            }
        }
    }
    free(sums as ptr<f32>)
    free(seconds as ptr<f32>)
    free(patch)

    let eigenvectors: ptr<f32> = alloc_f32(144)
    for i in 0 to 12 { eigenvectors[i*12+i] = 1.0 }

    # Symmetric Jacobi: A <- R^T A R; V <- V R.
    for iteration in 0 to 240 {
        let mut p: i32 = 0
        let mut q: i32 = 1
        let mut biggest: f32 = 0.0
        for i in 0 to 12 {
            for j in i+1 to 12 {
                let value: f32 = covariance[i*12+j]
                let mut absolute: f32 = value
                if absolute < 0.0 { absolute = 0.0-absolute }
                if absolute > biggest { biggest = absolute; p = i; q = j }
            }
        }
        if biggest < 0.0000001 { break }
        let app: f32 = covariance[p*12+p]
        let aqq: f32 = covariance[q*12+q]
        let apq: f32 = covariance[p*12+q]
        let tau: f32 = (aqq-app)/(2.0*apq)
        let mut t: f32 = 0.0
        if tau >= 0.0 {
            t = 1.0/(tau+sqrtf(1.0+tau*tau))
        } else {
            t = -1.0/(-tau+sqrtf(1.0+tau*tau))
        }
        let co: f32 = 1.0/sqrtf(1.0+t*t)
        let si: f32 = t*co
        for i in 0 to 12 {
            if i != p and i != q {
                let aip: f32 = covariance[i*12+p]
                let aiq: f32 = covariance[i*12+q]
                covariance[i*12+p] = co*aip-si*aiq
                covariance[p*12+i] = covariance[i*12+p]
                covariance[i*12+q] = si*aip+co*aiq
                covariance[q*12+i] = covariance[i*12+q]
            }
            let vip: f32 = eigenvectors[i*12+p]
            let viq: f32 = eigenvectors[i*12+q]
            eigenvectors[i*12+p] = co*vip-si*viq
            eigenvectors[i*12+q] = si*vip+co*viq
        }
        covariance[p*12+p] = app-t*apq
        covariance[q*12+q] = aqq+t*apq
        covariance[p*12+q] = 0.0
        covariance[q*12+p] = 0.0
    }

    # Descending eigenvalue sort. Eigenvector columns are the PCA filters.
    let used: ptr<i32> = alloc_i32(12)
    for out in 0 to 12 {
        let mut best: i32 = -1
        for j in 0 to 12 {
            if used[j] == 0 {
                if best == -1 or covariance[j*12+j] > covariance[best*12+best] {
                    best = j
                }
            }
        }
        used[best] = 1
        let mut eigenvalue: f32 = covariance[best*12+best]
        if eigenvalue < 0.0 { eigenvalue = 0.0 }
        let scale: f32 = 1.0/sqrtf(eigenvalue+0.01)
        for i in 0 to 12 {
            let coefficient: f32 = eigenvectors[i*12+best]*scale
            layer.weight[out*12+i] = coefficient
            layer.weight[(out+12)*12+i] = 0.0-coefficient
        }
    }

    free(used as ptr<f32>)
    free(eigenvectors)
    free(covariance)
}

# Default is an economical 4x4 grid of patches per image, rather than four
# arbitrary positions. Training can set stride=1 for exhaustive whitening.
function whitening_fit(layer: Conv, d: Dataset, examples: i32) -> void {
    whitening_fit_stride(layer,d,examples,8)
}
