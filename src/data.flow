# CIFAR-10 binary dataset loader and deterministic native Flow augmentations.
# Download the 170 MB binary tarball using scripts/download-data.sh.
# The binary records are 1 label byte + 3072 CHW image bytes.

extern {
    function fopen(path: string, mode: string) -> ptr<u8>
    function fread(buffer: ptr<u8>, size: i64, count: i64, file: ptr<u8>) -> i64
    function fclose(file: ptr<u8>) -> i32
    function getenv(name: string) -> ptr<u8>
    function atoi(value: ptr<u8>) -> i32
}

struct Dataset {
    images: ptr<f32>,
    labels: ptr<i32>,
    count: i32
}

struct Batch {
    images: Tensor,
    targets: ptr<f32>,
    labels: ptr<i32>
}

function env_int(name: string, fallback: i32) -> i32 {
    let raw: ptr<u8> = getenv(name)
    if raw == null { return fallback }
    let value: i32 = atoi(raw)
    if value <= 0 { return fallback }
    return value
}

function dataset_create(count: i32) -> Dataset {
    return Dataset {
        images: alloc_f32(count * 3072),
        labels: alloc_i32(count),
        count: count
    }
}

function dataset_free(d: Dataset) -> void {
    free(d.images)
    free(d.labels as ptr<f32>)
}

# Returns number of records loaded, <= capacity. Missing files are an error.
function load_file(d: Dataset, path: string, start: i32, capacity: i32) -> i32 {
    let file: ptr<u8> = fopen(path,"rb")
    if file == null {
        print("Missing CIFAR-10 binary file: ")
        println(path)
        return -1
    }
    let record: ptr<u8> = malloc(3073) as ptr<u8>
    let mut read: i32 = 0
    while read < capacity {
        let n: i64 = fread(record,1,3073,file)
        if n == 0 { break }
        if n != 3073 {
            println("Truncated CIFAR-10 binary record")
            free(record as ptr<f32>)
            let _close: i32 = fclose(file)
            return -1
        }
        let dest: i32 = start + read
        d.labels[dest] = record[0] as i32
        if d.labels[dest] < 0 or d.labels[dest] >= CLASSES {
            println("Invalid CIFAR-10 label")
            free(record as ptr<f32>)
            let _close: i32 = fclose(file)
            return -1
        }
        for i in 0 to 3072 {
            d.images[dest*3072+i] = (record[i+1] as f32) / 255.0
        }
        read = read + 1
    }
    free(record as ptr<f32>)
    let _closed: i32 = fclose(file)
    return read
}

function load_train(limit: i32) -> Dataset {
    let mut n: i32 = limit
    if n > 50000 { n = 50000 }
    if n < 1 { n = 1 }
    let d: Dataset = dataset_create(n)
    let mut pos: i32 = 0
    if pos < n {
        let count: i32 = load_file(d,"data/cifar-10-batches-bin/data_batch_1.bin",pos,n-pos)
        if count < 0 { return d }
        pos = pos + count
    }
    if pos < n {
        let count: i32 = load_file(d,"data/cifar-10-batches-bin/data_batch_2.bin",pos,n-pos)
        if count < 0 { return d }
        pos = pos + count
    }
    if pos < n {
        let count: i32 = load_file(d,"data/cifar-10-batches-bin/data_batch_3.bin",pos,n-pos)
        if count < 0 { return d }
        pos = pos + count
    }
    if pos < n {
        let count: i32 = load_file(d,"data/cifar-10-batches-bin/data_batch_4.bin",pos,n-pos)
        if count < 0 { return d }
        pos = pos + count
    }
    if pos < n {
        let count: i32 = load_file(d,"data/cifar-10-batches-bin/data_batch_5.bin",pos,n-pos)
        if count < 0 { return d }
        pos = pos + count
    }
    return Dataset { images: d.images, labels: d.labels, count: pos }
}

function load_test(limit: i32) -> Dataset {
    let mut n: i32 = limit
    if n > 10000 { n = 10000 }
    if n < 1 { n = 1 }
    let d: Dataset = dataset_create(n)
    let found: i32 = load_file(d,"data/cifar-10-batches-bin/test_batch.bin",0,n)
    if found < 0 { return d }
    return Dataset { images: d.images, labels: d.labels, count: found }
}

# Statistics estimated exclusively on training images; same statistics
# are applied to test. Mean / standard deviation on [0,1] pixel inputs.
struct Statistics {
    mean: ptr<f32>,
    invstd: ptr<f32>
}

function train_statistics(d: Dataset) -> Statistics {
    let mean: ptr<f32> = alloc_f32(3)
    let invstd: ptr<f32> = alloc_f32(3)
    let count: i32 = d.count * 1024
    for ch in 0 to 3 {
        let mut sum: f64 = 0.0
        let mut sum_sq: f64 = 0.0
        for b in 0 to d.count {
            for i in 0 to 1024 {
                let x: f64 = d.images[b*3072+ch*1024+i] as f64
                sum = sum + x
                sum_sq = sum_sq + x*x
            }
        }
        let m: f64 = sum / (count as f64)
        let mut var: f64 = sum_sq / (count as f64) - m*m
        if var < 0.00000001 { var = 0.00000001 }
        mean[ch] = m as f32
        invstd[ch] = (1.0 / sqrtf(var as f32))
    }
    return Statistics { mean: mean, invstd: invstd }
}

function normalize_dataset(d: Dataset, stats: Statistics) -> void {
    for b in 0 to d.count {
        for ch in 0 to 3 {
            for i in 0 to 1024 {
                let idx: i32 = b*3072+ch*1024+i
                d.images[idx] = (d.images[idx] - stats.mean[ch]) * stats.invstd[ch]
            }
        }
    }
}

function statistics_free(s: Statistics) -> void {
    free(s.mean)
    free(s.invstd)
}

function shuffled_indices(size: i32) -> ptr<i32> {
    let p: ptr<i32> = alloc_i32(size)
    for i in 0 to size { p[i] = i }
    return p
}

function shuffle_indices(order: ptr<i32>, n: i32) -> void {
    let mut i: i32 = n-1
    while i > 0 {
        let j: i32 = (random01() * ((i+1) as f32)) as i32
        let temp: i32 = order[i]
        order[i] = order[j]
        order[j] = temp
        i = i - 1
    }
}

# Reflection matching torch.nn.functional.pad(mode="reflect") for +/-2.
function reflect32(i: i32) -> i32 {
    if i < 0 { return 0-i }
    if i >= 32 { return 62-i }
    return i
}

function batch_from_dataset(d: Dataset, order: ptr<i32>, start: i32, count: i32, training: bool, cutmix: bool) -> Batch {
    let images: Tensor = tensor(count,3,32,32)
    let targets: ptr<f32> = alloc_f32(count*CLASSES)
    let labels: ptr<i32> = alloc_i32(count)
    for b in 0 to count {
        let sample: i32 = order[start+b]
        labels[b] = d.labels[sample]
        targets[b*CLASSES+labels[b]] = 1.0
        let mut dy: i32 = 0
        let mut dx: i32 = 0
        let mut flip: bool = false
        if training {
            dy = (random01()*5.0) as i32 - 2
            dx = (random01()*5.0) as i32 - 2
            flip = random01() < 0.5
        }
        for ch in 0 to 3 {
            for y in 0 to 32 {
                for x in 0 to 32 {
                    let sy: i32 = reflect32(y+dy)
                    let mut sx: i32 = reflect32(x+dx)
                    if flip { sx = 31-sx }
                    images.data[tensor_index(images,b,ch,y,x)] = d.images[sample*3072+ch*1024+sy*32+sx]
                }
            }
        }
    }
    # HLB patches are 3x3 for the last six epochs, applied to a
    # random batch partner, with soft labels proportional to area.
    if cutmix and count > 1 {
        for b in 0 to count {
            let peer: i32 = (random01()*(count as f32)) as i32
            let left: i32 = (random01()*30.0) as i32
            let top: i32 = (random01()*30.0) as i32
            for ch in 0 to 3 {
                for y in top to top+3 {
                    for x in left to left+3 {
                        let out: i32 = tensor_index(images,b,ch,y,x)
                        let source: i32 = tensor_index(images,peer,ch,y,x)
                        images.data[out] = images.data[source]
                    }
                }
            }
            let mix: f32 = 9.0/1024.0
            for cls in 0 to CLASSES {
                targets[b*CLASSES+cls] = (1.0-mix)*targets[b*CLASSES+cls] + mix*targets[peer*CLASSES+cls]
            }
        }
    }
    return Batch { images: images, targets: targets, labels: labels }
}

function batch_free(b: Batch) -> void {
    tensor_free(b.images)
    free(b.targets)
    free(b.labels as ptr<f32>)
}
